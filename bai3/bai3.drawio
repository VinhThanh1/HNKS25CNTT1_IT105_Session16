        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml ERD_Bai2_RikkeiCinema\n!theme plain\nskinparam linetype ortho\nskinparam class {\n    BackgroundColor&lt;&lt;entity&gt;&gt; #E8EEF7\n    BorderColor #2E75B6\n    HeaderBackgroundColor #2E75B6\n    FontColor #000000\n}\nskinparam classAttributeIconSize 0\n\ntitle Sơ đồ ERD đã sửa - Rikkei Cinema (Bài 2)\n\nentity \&quot;BOOKING\&quot; as BOOKING &lt;&lt;entity&gt;&gt; {\n    * **BookingID** : int &lt;&lt;PK&gt;&gt;\n    --\n    BookingDate : datetime\n    CustomerID : int &lt;&lt;FK&gt;&gt;\n}\n\nentity \&quot;SEAT\&quot; as SEAT &lt;&lt;entity&gt;&gt; {\n    * **SeatID** : int &lt;&lt;PK&gt;&gt;\n    --\n    SeatNumber : string\n    SeatType : string\n}\n\nentity \&quot;TICKET / BOOKING_DETAIL\&quot; as TICKET &lt;&lt;entity&gt;&gt; {\n    * **TicketID** : int &lt;&lt;PK&gt;&gt;\n    --\n    BookingID : int &lt;&lt;FK&gt;&gt;\n    SeatID : int &lt;&lt;FK&gt;&gt;\n    ShowtimeID : int &lt;&lt;FK&gt;&gt;\n    Price : decimal\n}\n\nBOOKING ||--o{ TICKET : \&quot;1  -  N\&quot;\nSEAT ||--o{ TICKET : \&quot;1  -  N\&quot;\n\nnote right of TICKET\n  ShowtimeID tham chiếu thực thể\n  Suất chiếu (sẽ thiết kế ở bài sau).\n  Unique constraint đề xuất:\n  (SeatID, ShowtimeID)\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="WoPdkJG-aIIKq5eubjF9-1">
